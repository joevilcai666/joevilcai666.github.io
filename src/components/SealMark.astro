---
// 「骥」字印章 —— 站点视觉锚点
// 骥，千里马也。名取自《论语》"骥不称其力，称其德也"。
const { size = 28, char = '骥' } = Astro.props;
---

<svg
  class="seal-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label={`印章：${char}`}
>
  <rect x="2" y="2" width="60" height="60" rx="12" fill="var(--seal)"></rect>
  <rect x="5" y="5" width="54" height="54" rx="9.5" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.2"></rect>
  <text
    x="32"
    y="45"
    text-anchor="middle"
    dominant-baseline="middle"
    font-family="STKaiti, Kaiti SC, KaiTi, Noto Serif SC, serif"
    font-size="38"
    font-weight="700"
    fill="#fdfcfa">骥</text
  >
</svg>
