---
import { PROJECTS } from '../../data/projects';
import { UI, t } from '../../data/i18n';
import { withBase } from '../../data/site';
const {lang} = Astro.props;
const ui = UI[lang];
const base = lang === 'en' ? '/en' : '';
---
<div class="back-line"><a href={withBase(base ? '/en/' : '/')}>{ui.backLabel}</a></div>
<h1 class="section-h projects-heading">{ui.projectsTitle}</h1>
<div class="visual-projects">
  {PROJECTS.map(project => <article class={`visual-project project-${project.id}`} id={project.id}>
    <a class="project-cover" href={withBase(`${base}/projects/${project.id}/`)}>{(project.previews || [project.preview]).map((preview, index) => <img src={withBase(preview)} alt={`${project.name} ${lang === 'zh' ? '设计原型' : 'design prototype'} ${index + 1}`} loading="lazy" />)}</a>
    <div class="visual-project-copy"><div class="visual-project-title"><h2>{project.name}</h2></div><p class="visual-project-tagline">{t(project.tagline,lang)}</p><p class="visual-project-description">{t(project.description,lang)}</p><div class="project-footnotes"><div class="project-link-group">{project.links?.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a href={withBase(`${base}/projects/${project.id}/`)}>{lang === 'zh' ? '查看项目' : 'View project'} ↗</a></div></div></div>
  </article>)}
</div>
