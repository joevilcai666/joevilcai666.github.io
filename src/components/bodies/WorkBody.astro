---
import { WORK } from '../../data/work';
import { UI, t, type Lang } from '../../data/i18n';
import { withBase } from '../../data/site';

const { lang } = Astro.props;
const ui = UI[lang];
const base = lang === 'en' ? '/en' : '';
const langToggleHref = withBase(`/en${Astro.url.pathname}`);
---

<div class="back-line">
  <a href={withBase(base ? '/en/' : '/')}>{ui.backLabel}</a>
  <a href={langToggleHref} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>{ui.langToggle}</a>
</div>

<h1 class="section-h">{ui.workTitle}</h1>
<p class="tagline" style="margin:0.375rem 0 2rem">{ui.workRange} · {ui.workSub}</p>

<ol class="timeline">
  {
    WORK.map((item) => (
      <li class={item.current ? 'current' : ''}>
        <p class="when">
          {item.current && <span class="now" aria-hidden="true" />}
          {item.period}
        </p>
        <div class="tl-head">
          <span class="wf-logo">
            <img src={withBase(item.logo)} alt="" width="18" height="18" loading="lazy" />
          </span>
          <h2>{t(item.role, lang)}</h2>
        </div>
        {item.href ? (
          <a class="org-link" href={item.href} target="_blank" rel="noopener">
            {t(item.org, lang)}
          </a>
        ) : (
          <p class="org">{t(item.org, lang)}</p>
        )}
        <p class="summary">{t(item.summary, lang)}</p>
        {item.highlights.length > 0 && (
          <ul class="points">
            {item.highlights.map((h) => (
              <li>{t(h, lang)}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
