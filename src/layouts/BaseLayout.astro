---
import '@fontsource-variable/inter';
import '../styles/global.css';
import ThemeControls from '../components/ThemeControls.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import '../styles/portfolio.css';
import { SITE, withBase } from '../data/site';
import { UI, counterpartPath, hasCounterpart, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** 首页：身份与联系方式、内容导航、语言设置 */
  home?: boolean;
  /** 长文阅读页 */
  prose?: boolean;
}

const { lang = 'zh', title, home = false, prose = false } = Astro.props;
const ui = UI[lang];
const description = Astro.props.description ?? ui.description;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 语言切换：中文在根路径，英文在 /en/ 下
const path = Astro.url.pathname;
const homeHref = withBase(lang === 'en' ? '/en/' : '/');

// hreflang 双语互指（仅限有对侧版本的页面）
const hasAlt = hasCounterpart(path);
const altZh = new URL(withBase(counterpartPath(path, 'en')), Astro.site);
const altEn = new URL(withBase(counterpartPath(path, 'zh')), Astro.site);
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('joe-color-theme') || 'system';
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch {}
    </script>
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <link rel="canonical" href={canonical} />
    {hasAlt && <link rel="alternate" hreflang="zh-CN" href={altZh} />}
    {hasAlt && <link rel="alternate" hreflang="en" href={altEn} />}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={altZh} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body
    class:list={[home ? 'portfolio-home' : 'portfolio-inner']}
    data-base-home={homeHref}
    data-base-work={withBase(lang === 'en' ? '/en/work' : '/work')}
    data-base-projects={withBase(lang === 'en' ? '/en/projects/' : '/projects/')}
    data-base-blog={withBase(lang === 'en' ? '/en/blog/' : '/blog/')}
  >
    <main class:list={[home ? 'home-page' : 'page']}>
      {!home && <div class="inner-theme"><ThemeControls lang={lang} compact /></div>}
      <slot />
      {!home && <div class="page-language"><LanguageSwitch lang={lang} /></div>}
    </main>


    <script>
      // 只给指针展开添加反馈。键盘展开立即呈现，快速开合时取消旧动画。
      document.querySelectorAll<HTMLDetailsElement>('.work-fold details').forEach((details) => {
        const summary = details.querySelector('summary');
        const content = details.querySelector<HTMLElement>('.wf-body');
        if (!summary || !content) return;
        let reveal: Animation | undefined;

        summary.addEventListener('pointerdown', () => { details.dataset.pointer = ''; });
        summary.addEventListener('keydown', () => { delete details.dataset.pointer; });
        summary.addEventListener('click', (event) => {
          if (event.detail === 0) delete details.dataset.pointer;
        });
        details.addEventListener('toggle', () => {
          reveal?.cancel();
          if (!details.open || !details.hasAttribute('data-pointer')) return;
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          reveal = content.animate(
            reduced
              ? [{ opacity: 0 }, { opacity: 1 }]
              : [{ opacity: 0, transform: 'translateY(-2px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: reduced ? 100 : 180, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
          );
        });
      });

      // 键盘导航：W / P / B 直达分区，Esc 从内页返回首页（输入框内不触发）
      const body = document.body;
      const base = {
        w: body.dataset.baseWork ?? '/work',
        p: body.dataset.baseProjects ?? '/projects/',
        b: body.dataset.baseBlog ?? '/blog/',
        home: body.dataset.baseHome ?? '/',
      };
      const samePath = (a: string) =>
        location.pathname.replace(/\/+$/, '') === a.replace(/\/+$/, '');

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement | null;
        if (target && /^(input|textarea|select)$/i.test(target.tagName)) return;
        const key = e.key.toLowerCase();
        if (key === 'w' || key === 'p' || key === 'b') {
          const dest = base[key];
          if (!samePath(dest)) location.href = dest;
        } else if (key === 'escape') {
          if (!samePath(base.home)) location.href = base.home;
        }
      });
    </script>
  </body>
</html>
