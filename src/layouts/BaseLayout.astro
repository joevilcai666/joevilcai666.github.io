---
import '@fontsource-variable/inter';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import SealMark from '../components/SealMark.astro';
import Icon from '../components/icons/Icon.astro';
import { SITE, withBase } from '../data/site';
import { UI, counterpartPath, hasCounterpart, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** 首页不渲染任何角落导航，纯内容呈现 */
  home?: boolean;
}

const { lang = 'zh', title, home = false } = Astro.props;
const ui = UI[lang];
const description = Astro.props.description ?? ui.description;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.fullName} · ${ui.siteTagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 语言切换：中文在根路径，英文在 /en/ 下
const path = Astro.url.pathname;
const langToggleHref = withBase(counterpartPath(path, lang));
const hreflangAlt = lang === 'zh' ? 'en' : 'zh-CN';
const switchLabel = lang === 'zh' ? 'Switch to English' : '切换到中文';
const homeHref = withBase(lang === 'en' ? '/en/' : '/');

// hreflang 双语互指（仅限有对侧版本的页面）
const hasAlt = hasCounterpart(path);
const altZh = new URL(withBase(counterpartPath(path, 'en')), Astro.site);
const altEn = new URL(withBase(counterpartPath(path, 'zh')), Astro.site);
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <link rel="canonical" href={canonical} />
    {hasAlt && <link rel="alternate" hreflang="zh-CN" href={altZh} />}
    {hasAlt && <link rel="alternate" hreflang="en" href={altEn} />}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={altZh} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    {
      home ? null : (
        <div class="corner">
          <a class="corner-home" href={homeHref} aria-label={lang === 'en' ? 'Home' : '回到首页'}>
            <SealMark size={24} />
          </a>
          <a class="corner-lang" href={langToggleHref} hreflang={hreflangAlt} aria-label={switchLabel}>
            <Icon name="lang" />
            {ui.langToggle}
          </a>
        </div>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="colophon">© {new Date().getFullYear()} Joe</footer>
  </body>
</html>
