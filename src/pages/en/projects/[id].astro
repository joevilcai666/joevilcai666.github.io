---
import {PROJECTS} from '../../../data/projects';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailBody from '../../../components/bodies/ProjectDetailBody.astro';
export function getStaticPaths(){ return PROJECTS.map(project => ({params:{id:project.id},props:{project}})); }
const {project} = Astro.props;
---
<BaseLayout lang="en" title={project.name} description={project.tagline.en}><ProjectDetailBody lang="en" project={project}/></BaseLayout>
