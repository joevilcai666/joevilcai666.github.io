---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
---

<BaseLayout title="项目" description="蔡骥淳（Joe）的项目 —— MemLoom 记忆系统、记忆系统评测系列、回信小程序原型等。">
  <div class="page-head">
    <span class="eyebrow">lab</span>
    <h1>项目</h1>
    <p class="sub">在做的、做过的，以及还在纸上打磨的。</p>
  </div>

  <div class="project-list">
    {
      PROJECTS.map((p) => (
        <article id={p.id} class="project-card">
          <header class="project-head">
            <h2>{p.name}</h2>
            <span class="tag t-proj">{p.status}</span>
          </header>
          <p class="project-tagline">{p.tagline}</p>
          <p class="project-desc">{p.description}</p>
          <div class="chips">
            {p.stack.map((s) => (
              <span class="chip">{s}</span>
            ))}
          </div>
          {p.links && p.links.length > 0 && (
            <p class="project-links">
              {p.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </>
              ))}
            </p>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.4rem 1.5rem;
    background: color-mix(in srgb, var(--fill) 40%, var(--paper));
    scroll-margin-top: 5rem;
    transition: border-color 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--line-strong);
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.2rem;
  }

  .project-head h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .project-tagline {
    margin: 0 0 0.7rem;
    color: var(--c-proj);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .project-desc {
    margin: 0 0 0.9rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .project-links {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
  }
</style>
